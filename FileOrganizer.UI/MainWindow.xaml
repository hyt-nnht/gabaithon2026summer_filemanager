<Window x:Class="FileOrganizer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Organizer"
        Width="1280"
        Height="800"
        MinWidth="1060"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,26,18,24">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="F" Foreground="White" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="File Organizer" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="LOCAL • PRIVATE" Foreground="#7F8BA5" FontSize="9" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#2A2F4D" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="17"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Width="3" Height="20" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="3" Margin="14,12,14,20" Padding="13" CornerRadius="11" Background="#1A2232">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="9" Height="9" CornerRadius="5" Background="#52D69A" VerticalAlignment="Top" Margin="0,4,9,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ConnectionLabel}" Foreground="#DCE2ED" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="ファイル操作なし" Foreground="#7F8BA5" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" />

            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="30" Padding="16,11" CornerRadius="10"
                    Background="#E9182033"
                    Visibility="{Binding IsMessageVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.22" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Message}" Foreground="White" VerticalAlignment="Center" MaxWidth="700" />
                    <Button Content="×" Command="{Binding DismissMessageCommand}" Style="{StaticResource GhostButtonStyle}"
                            Foreground="White" Margin="14,0,0,0" Padding="4,0" MinHeight="22" />
                </StackPanel>
            </Border>

            <Border Background="#44FFFFFF"
                    Visibility="{Binding IsInitializing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="180" Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="画面を準備しています…" Margin="0,14,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

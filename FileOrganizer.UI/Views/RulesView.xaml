<UserControl x:Class="FileOrganizer.UI.Views.RulesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FileOrganizer.UI.ViewModels">
    <Grid Margin="34,28,34,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="整理ルール" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="上から順に評価し、最初に一致したルールを適用します。"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="未保存の変更があります" Foreground="{StaticResource WarningBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Content="ルールを保存" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,2,4,12">
                        <TextBlock Text="優先順位" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="↑" Command="{Binding MoveUpCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="上へ" />
                            <Button Content="↓" Command="{Binding MoveDownCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="下へ" />
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="11">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F2F4F9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,2,0,2" />
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" Style="{StaticResource CheckBoxStyle}"
                                              VerticalAlignment="Center" ToolTip="有効 / 無効" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="＋  新しいルール" Command="{Binding AddRuleCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="4,12,4,2" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="22,18,22,14" Visibility="{Binding HasRules, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ルールを編集" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="条件はすべて満たした場合に一致します。" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="複製" Command="{Binding DuplicateCommand}" Style="{StaticResource GhostButtonStyle}" />
                            <Button Content="削除" Command="{Binding DeleteRuleCommand}" Style="{StaticResource DangerButtonStyle}" Margin="6,0,0,0" Padding="12,7" MinHeight="32" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasRules, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="22,2,22,24" DataContext="{Binding SelectedRule}">
                            <TextBlock Text="ルール名" Style="{StaticResource CaptionStyle}" Margin="0,8,0,6" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" FontSize="15" FontWeight="SemiBold" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="監視フォルダ" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding WatchFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="このルールを有効にする" IsChecked="{Binding Enabled}"
                                          Style="{StaticResource CheckBoxStyle}" Margin="18,21,0,0" VerticalAlignment="Top" />
                            </Grid>

                            <Grid Margin="0,24,0,10">
                                <TextBlock Text="もし（条件）" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                <Button Content="＋ 条件を追加" Command="{Binding DataContext.AddConditionCommand, ElementName=Root}"
                                        Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Conditions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8F9FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="42" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" ItemsSource="{x:Static vm:ConditionEditorViewModel.TypeOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Type}"
                                                          Style="{StaticResource ComboBoxStyle}" />
                                                <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:ConditionEditorViewModel.OperatorOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Operator}"
                                                          Style="{StaticResource ComboBoxStyle}" />
                                                <TextBox Grid.Column="4" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" />
                                                <Button Grid.Column="5" Content="×" Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,15" />

                            <Grid Margin="0,1,0,10">
                                <TextBlock Text="なら（アクション）" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                <Button Content="＋ アクションを追加" Command="{Binding DataContext.AddActionCommand, ElementName=Root}"
                                        Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Actions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8F9FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="2.6*" />
                                                    <ColumnDefinition Width="42" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" ItemsSource="{x:Static vm:ActionEditorViewModel.TypeOptions}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Type}"
                                                          Style="{StaticResource ComboBoxStyle}" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding ArgumentLabel}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding Argument, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"
                                                             IsEnabled="{Binding HasArgument}" />
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="×" Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="#FFF8E8" BorderBrush="#FFE5AF" BorderThickness="1" CornerRadius="10"
                                    Padding="13" Margin="0,13,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ⓘ" Foreground="{StaticResource WarningBrush}" Margin="0,0,9,0" />
                                    <TextBlock Text="同名ファイルは上書きせず _1, _2 の連番を付けます。実行前のDry Runでも確認できます。"
                                               Foreground="#795D19" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasRules, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Border Width="54" Height="54" CornerRadius="16" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="◇" FontSize="25" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="整理ルールがありません" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <TextBlock Text="左下のボタンから最初のルールを作成してください。" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

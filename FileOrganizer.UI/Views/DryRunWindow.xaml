<Window x:Class="FileOrganizer.UI.Views.DryRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="整理内容の確認"
        Width="920" Height="650"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="28,24,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentSoftBrush}" Margin="0,0,12,0">
                        <TextBlock Text="✦" Foreground="{StaticResource AccentBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="整理内容を確認" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="ファイルはまだ変更されていません" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="×" Command="{Binding CancelCommand}" Style="{StaticResource IconButtonStyle}" />
        </Grid>

        <Border Grid.Row="1" Margin="28,0,28,16" Padding="13,10" Background="#EEF0FF" CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="ⓘ" Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#3E458F" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FolderPath}" Foreground="#656BA9" FontSize="10" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="2,0,10,9">
                <CheckBox Content="すべて選択" IsChecked="{Binding AreAllSelected, Mode=TwoWay}" Style="{StaticResource CheckBoxStyle}" />
                <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} 件を選択中}" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding RequiresConfirmation, Converter={StaticResource InverseBooleanConverter}}"
                                              Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SourceFileName}" FontWeight="SemiBold" FontSize="13" />
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="8,3" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding OperationLabel}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="#FFF5D9" CornerRadius="12" Padding="8,3" Margin="6,0,0,0"
                                                    Visibility="{Binding RequiresConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="要確認" Foreground="#9A6B08" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SourcePath}" Style="{StaticResource CaptionStyle}" Margin="0,7,0,0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SourcePath}" />
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="↓" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DestinationPath}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding DestinationPath}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionStyle}" Margin="18,5,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding RuleName}" Style="{StaticResource CaptionStyle}" Margin="14,2,0,0" MaxWidth="155" TextAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Width="190" Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="ルールと同名衝突を確認しています…" Style="{StaticResource CaptionStyle}" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,16" Background="#FAFBFD">
            <Grid>
                <StackPanel>
                    <TextBlock Text="安全チェック" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Text="実行直前に元ファイル・整理先・軽量ハッシュを再確認し、上書きは行いません。"
                               Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="キャンセル" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="{Binding ExecuteLabel}" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="170" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="FileOrganizer.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="34,28,34,36" MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="おかえりなさい" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="散らかったファイルを、ローカルで静かに整えます。"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ShowDropZoneCommand}" Style="{StaticResource SecondaryButtonStyle}"
                            Content="Drop Zone" Margin="0,0,8,0" />
                    <Button Command="{Binding RequestDryRunCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="20,11">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="今すぐ整理" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" CornerRadius="18" Padding="26" Margin="0,0,0,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5B5FEF" Offset="0" />
                        <GradientStop Color="#777AF4" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" Background="#27FFFFFF" CornerRadius="11" Margin="0,0,13,0">
                                <TextBlock Text="●" Foreground="#A7F3D0" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding MonitoringTitle}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MonitoringDescription}" Foreground="#E5E7FF" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Border Background="#1FFFFFFF" CornerRadius="9" Padding="12,9" Margin="0,20,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="監視先" Foreground="#D9DBFF" FontSize="11" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding PrimaryWatchFolder}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Command="{Binding ToggleMonitoringCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding MonitoringButtonLabel}" MinWidth="150" />
                        <TextBlock Text="{Binding LastProcessedLabel}" Foreground="#DFE1FF" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="今日整理したファイル" Style="{StaticResource CaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding OrganizedToday}" FontSize="27" FontWeight="SemiBold" />
                            <TextBlock Text=" 件" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,5" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="整理待ち" Style="{StaticResource CaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding PendingFiles}" FontSize="27" FontWeight="SemiBold" />
                            <TextBlock Text=" 件" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,5" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="解析エンジン" Style="{StaticResource CaptionStyle}" />
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="9" Height="9" CornerRadius="5" Background="{StaticResource SuccessBrush}" Margin="0,5,8,0" />
                                <TextBlock Text="{Binding AiStatus}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                            <ProgressBar Height="4" Margin="0,10,0,0" IsIndeterminate="True"
                                         Foreground="{StaticResource AccentBrush}"
                                         Visibility="{Binding IsAiAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="最近の整理" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="直近3件" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RecentItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="{Binding OperationLabel}" FontSize="9" Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,12,0">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding DestinationPath}" Style="{StaticResource CaptionStyle}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="処理の流れ" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="バックエンド接続時は、この順に状態が更新されます。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,16" />

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="1" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="検知・安定確認" FontWeight="SemiBold"/><TextBlock Text="書き込み完了を2回確認" Style="{StaticResource CaptionStyle}"/></StackPanel>
                        </Grid>
                        <Border Width="1" Height="13" Background="{StaticResource BorderBrush}" HorizontalAlignment="Left" Margin="12,1" />
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="2" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="OCR・ローカルAI解析" FontWeight="SemiBold"/><TextBlock Text="失敗時はルールへフォールバック" Style="{StaticResource CaptionStyle}"/></StackPanel>
                        </Grid>
                        <Border Width="1" Height="13" Background="{StaticResource BorderBrush}" HorizontalAlignment="Left" Margin="12,1" />
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="3" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="安全に整理・履歴保存" FontWeight="SemiBold"/><TextBlock Text="Planned → Executing → Completed" Style="{StaticResource CaptionStyle}"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

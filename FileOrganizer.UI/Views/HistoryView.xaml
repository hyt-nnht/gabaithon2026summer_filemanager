<UserControl x:Class="FileOrganizer.UI.Views.HistoryView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,28,34,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="実行履歴" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="何が、いつ、どこへ整理されたかを確認し、安全に元へ戻せます。"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EAF8F1" CornerRadius="16" Padding="11,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Foreground="{StaticResource SuccessBrush}" FontSize="9" Margin="0,2,7,0" />
                    <TextBlock Text="履歴はローカルに保存" Foreground="#167A53" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="ファイル名またはパスで検索" Style="{StaticResource TextBoxStyle}" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                      Style="{StaticResource ComboBoxStyle}" />
            <Button Grid.Column="4" Content="↻  更新" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="22,15" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="105" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="日時 / 操作" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Grid.Column="1" Text="元のファイル" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Grid.Column="2" Text="整理先" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Grid.Column="3" Text="状態" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="2.1*" />
                                            <ColumnDefinition Width="2.1*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TimeLabel}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding OperationLabel}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding SourcePath}" Style="{StaticResource CaptionStyle}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SourcePath}" />
                                            <TextBlock Text="{Binding FileSizeLabel}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,18,0">
                                            <TextBlock Text="{Binding DestinationPath}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" ToolTip="{Binding DestinationPath}" />
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,4,0,0"
                                                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <Border Grid.Column="3" CornerRadius="14" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource PillStyle}">
                                                    <Setter Property="Background" Value="#FFF5D9" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StateBrushKey}" Value="success">
                                                            <Setter Property="Background" Value="#EAF8F1" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateBrushKey}" Value="danger">
                                                            <Setter Property="Background" Value="#FFF0F2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateBrushKey}" Value="neutral">
                                                            <Setter Property="Background" Value="#EEF1F5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateLabel}" FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#9A6B08" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateBrushKey}" Value="success"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding StateBrushKey}" Value="danger"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding StateBrushKey}" Value="neutral"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Button Grid.Column="4" Content="元に戻す"
                                                Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,7" MinHeight="32"
                                                IsEnabled="{Binding CanUndo}" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="履歴が見つかりません" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="検索条件を変えるか、ファイルを整理するとここに表示されます。" Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

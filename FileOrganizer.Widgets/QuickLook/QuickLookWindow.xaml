<Window x:Class="FileOrganizer.Widgets.QuickLook.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Look"
        Width="760" Height="520"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#111827"
        KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="20,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Text="{Binding FilePath}" Foreground="#8E9AAF" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="×" Click="OnCloseClicked" Width="34" Height="34" Background="#253044" Foreground="White"
                    BorderThickness="0" FontSize="17" Cursor="Hand" />
        </Grid>

        <Border Grid.Row="1" Background="#F8F9FC" CornerRadius="13" Margin="20,0" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="13" Background="#E9EBFF">
                        <TextBlock Text="{Binding KindGlyph}" Foreground="#5B5FEF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="13,2,0,0">
                        <TextBlock Text="{Binding KindLabel}" Foreground="#182033" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DetailLabel}" Foreground="#667085" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,20,0,0" Background="White" BorderBrush="#E5E9F2" BorderThickness="1" CornerRadius="10" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding PreviewText}" Foreground="#344054" FontSize="13" LineHeight="21" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Space または Esc で閉じる" Foreground="#8E9AAF" FontSize="10"
                   HorizontalAlignment="Center" Margin="0,13,0,15" />
    </Grid>
</Window>

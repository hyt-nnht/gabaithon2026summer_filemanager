<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>main.py</StartupFile>
    <SearchPath>src</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>py_service</Name>
    <RootNamespace>py_service</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="main.py" />
    <Compile Include="src\**\*.py" />
    <Compile Include="tests\**\*.py" />
    <Content Include="README.md" />
    <Content Include="pyproject.toml" />
    <Content Include="requirements.txt" />
    <Content Include="機能説明書.md" />
    <Content Include="openapi_schema.json" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="src\" />
    <Folder Include="src\file_analyzer\" />
    <Folder Include="src\file_analyzer\api\" />
    <Folder Include="src\file_analyzer\classifiers\" />
    <Folder Include="src\file_analyzer\extractors\" />
    <Folder Include="tests\" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>
